<Window x:Class="echo_client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client"
        Height="650" Width="500"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Grid Background="#DDD">
        <Border BorderBrush="Black" BorderThickness="1" Margin="30" Padding="20">
            <StackPanel>

                <!-- 타이틀 -->
                <TextBlock Text="Client" FontSize="20" FontWeight="Bold" Foreground="Red" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- 사용자 정보 입력 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="이름:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Name="txtUserName" Width="120" Margin="0,0,15,0"/>
                    <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Name="txtUserId" Width="120"/>
                </StackPanel>

                <!-- 메시지 리스트 -->
                <TextBlock Text="보낸 메시지" FontSize="14" FontWeight="Bold" Foreground="Red" Margin="0,0,0,5"/>
                <ListBox Name="lstMessages" Height="300" Margin="0,0,0,10"/>

                <!-- 연결 상태 -->
                <Label Name="lblStatus" Content="연결되지 않음" Foreground="Red" FontWeight="Bold" />

                <!-- 메시지 전송 영역 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBox Name="txtMessage" Width="280" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Send" Width="80" Height="30" Click="SendMessage_Click"/>
                </StackPanel>

                <!-- 연결 버튼 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Connect" Width="80" Height="30" Margin="0,0,20,0" Click="Connect_Click"/>
                    <Button Content="Disconnect" Width="100" Height="30" Click="Disconnect_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
