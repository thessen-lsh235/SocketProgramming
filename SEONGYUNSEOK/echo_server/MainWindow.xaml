<Window x:Class="echo_server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:echo_server"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="서버 상태" FontWeight="Bold"/>
            <ListBox Name="lstMessages" Height="300" Margin="0,5"/>
            <Button Content="서버 시작" Click="StartServer_Click"/>
        </StackPanel>
    </Grid>

</Window>
